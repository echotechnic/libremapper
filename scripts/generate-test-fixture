def render_artifacts(data: dict[str, Any]) -> dict[str, str]:
    outputs: dict[str, str] = {}
    for file_number, artifact in enumerate(data["artifacts"], 1):
        blocks = []
        for neighbor_number, neighbor in enumerate(artifact["neighbors"], 1):
            mac = f"02:ff:{file_number:02x}:00:00:{neighbor_number:02x}"
            address = neighbor["remote_ip"] or f"198.51.100.{file_number * 10 + neighbor_number}"
            blocks.append(
                "\n".join(
                    [
                        "+--------------------+-----------------------------------------+",
                        f"| interface          | {neighbor['local_interface']}",
                        f"| chassis-id         | {mac}",
                        f"| port-id            | {neighbor['remote_interface']}",
                        f"| system-name        | {neighbor['remote_hostname']}",
                        f"| management-address | {address}",
                    ]
                )
            )
        name = f"topology/{artifact['hostname']}--lldp-neighbors"
        outputs[name] = "\n\n".join(blocks) + "\n"
    return outputs


def expected_files(fixture: Path) -> dict[Path, str]:
    data = json.loads((fixture / "topology.json").read_text())
    validate(data)
    files = {fixture / "librenms-seed.sql": render_sql(data)}
    files.update(
        {fixture / "artifacts" / name: text for name, text in render_artifacts(data).items()}
    )
    return files


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--fixture", type=Path, default=DEFAULT_FIXTURE)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    files = expected_files(args.fixture)
    if args.check:
        stale = [
            str(path)
            for path, content in files.items()
            if not path.is_file() or path.read_text() != content
        ]
        expected_artifacts = {path for path in files if "artifacts" in path.parts}
        actual_artifacts = {
            path for path in (args.fixture / "artifacts").rglob("*") if path.is_file()
        }
        stale.extend(str(path) for path in sorted(actual_artifacts - expected_artifacts))
        if stale:
            raise SystemExit("stale generated fixture files:\n" + "\n".join(stale))
    else:
        for path, content in files.items():
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content)
    print(f"fixture ok: {len(files) - 1} artifacts")


if __name__ == "__main__":
    main()
