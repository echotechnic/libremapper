#!/usr/bin/env python3
"""Generate the committed, inert LibreNMS/SAOS test fixture."""

from __future__ import annotations

import argparse
import ipaddress
import json
import re
from collections import Counter
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
DEFAULT_FIXTURE = ROOT / "tests/fixtures/synthetic-core"
HOSTNAME = re.compile(r"[a-z0-9]+\.site(?:0[0-9])\.example\.test")
INTERFACE = re.compile(r"[A-Za-z0-9._/+:-]+")


def sql_value(value: Any) -> str:
    if value is None:
        return "NULL"
    if isinstance(value, bool):
        return str(int(value))
    if isinstance(value, (int, float)):
        return str(value)
    return "'" + str(value).replace("\\", "\\\\").replace("'", "''") + "'"


def insert(table: str, columns: list[str], rows: list[list[Any]]) -> str:
    values = ",\n".join("  (" + ", ".join(map(sql_value, row)) + ")" for row in rows)
    names = ", ".join(f"`{column}`" for column in columns)
    return f"INSERT INTO `{table}` ({names}) VALUES\n{values};\n"


def validate(data: dict[str, Any]) -> None:
    serialized = json.dumps(data).lower()
    assert not any(
        marker in serialized
        for marker in (".gov", "http://", "https://", "@", "password", "community", "secret")
    )
    assert data["version"] == 1
    assert len(data["artifacts"]) == 9
    assert sum(len(item["neighbors"]) for item in data["artifacts"]) == 31
    assert len(data["reference_map"]["nodes"]) == 26
    assert len(data["reference_map"]["edges"]) == 31
    assert len(data["groups"]) == 4
    assert data["ip_addresses"]
    assert data["mac_adjacencies"]
    assert data["bgp_peers"]
    assert data["ospf_neighbors"]

    device_ids = {device["id"] for device in data["devices"]}
    reference_device_ids = {
        node["device_id"]
        for node in data["reference_map"]["nodes"]
        if node["device_id"] is not None
    }
    assert {device_id for group in data["groups"] for device_id in group["device_ids"]} == (
        reference_device_ids
    )
    assert len({node["label"] for node in data["reference_map"]["nodes"]}) == 26
    assert Counter(device["role"] for device in data["devices"]) == {
        "border": 2,
        "core": 9,
        "customer": 14,
        "device": 4,
        "firewall": 2,
        "monitor": 1,
        "oob": 9,
        "pop": 2,
    }
    for role, prefix, count in (
        ("border", "border", 2),
        ("core", "core", 9),
        ("customer", "cust", 14),
        ("oob", "oob", 9),
        ("pop", "pop", 2),
    ):
        assert sorted(
            device["hostname"].split(".", 1)[0]
            for device in data["devices"]
            if device["role"] == role
        ) == [f"{prefix}{number:02d}" for number in range(1, count + 1)]
    assert {group["name"]: set(group["device_ids"]) for group in data["groups"]} == {
        "Reference Aggregation": {1001, 1002, 1020, 1021, 1023, 1024},
        "Reference Core": {1005, 1006},
        "Reference Customer": {
            1014,
            1015,
            1016,
            1017,
            1018,
            1019,
            1033,
            1034,
            1039,
            1040,
            1041,
            1042,
            1043,
        },
        "Reference POP": {1007, 1010},
    }
    port_ids = {port["id"] for port in data["ports"]}
    for device in data["devices"]:
        assert HOSTNAME.fullmatch(device["hostname"])
        assert ipaddress.ip_address(device["ip"]) in ipaddress.ip_network("192.0.2.0/24")
    for port in data["ports"]:
        assert port["device_id"] in device_ids
        assert INTERFACE.fullmatch(port["if_name"])
        assert INTERFACE.fullmatch(port["if_descr"])
        assert re.fullmatch(r"02:00:0[01]:[0-9a-f]{2}:[0-9a-f]{2}:[0-9a-f]{2}", port["mac"])
    for artifact in data["artifacts"]:
        assert HOSTNAME.fullmatch(artifact["hostname"])
        for neighbor in artifact["neighbors"]:
            assert HOSTNAME.fullmatch(neighbor["remote_hostname"])
            assert INTERFACE.fullmatch(neighbor["local_interface"])
            assert INTERFACE.fullmatch(neighbor["remote_interface"])
            if neighbor["remote_ip"]:
                assert ipaddress.ip_address(neighbor["remote_ip"]) in ipaddress.ip_network(
                    "192.0.2.0/24"
                )
    assert all(link["local_device_id"] in device_ids for link in data["native_links"])
    assert all(link["remote_device_id"] in device_ids for link in data["native_links"])
    assert all(link["local_port_id"] in port_ids for link in data["native_links"])
    assert all(link["remote_port_id"] in port_ids for link in data["native_links"])
    assert all(row["port_id"] in port_ids for row in data["ip_addresses"])
    assert all(row["port_id"] in port_ids for row in data["mac_adjacencies"])
    assert all(row["device_id"] in device_ids for row in data["bgp_peers"])
    assert all(row["device_id"] in device_ids for row in data["ospf_instances"])
    assert all(row["device_id"] in device_ids for row in data["ospf_neighbors"])
    assert all(row["port_id"] in port_ids for row in data["ospf_neighbors"])


def fixture_ports(data: dict[str, Any]) -> list[dict[str, Any]]:
    ports = [dict(port) for port in data["ports"]]
    device_ids = {device["hostname"]: device["id"] for device in data["devices"]}
    existing = {
        (port["device_id"], str(value))
        for port in ports
        for value in (port["if_name"], port["if_descr"], port["if_index"])
    }
    required: set[tuple[int, str]] = set()
    for artifact in data["artifacts"]:
        for neighbor in artifact["neighbors"]:
            required.add((device_ids[artifact["hostname"]], neighbor["local_interface"]))
            if neighbor["remote_hostname"] in device_ids:
                required.add(
                    (device_ids[neighbor["remote_hostname"]], neighbor["remote_interface"])
                )
    for device_id, name in sorted(required - existing):
        index = len(ports) + 1
        speed = 100_000_000_000
        rate = speed * [1, 10, 35, 65, 90][(index - 1) % 5] // 800
        ports.append(
            {
                "id": 2000 + index,
                "device_id": device_id,
                "if_name": name,
                "if_descr": name,
                "if_index": 10_000 + index,
                "if_type": "ethernetCsmacd",
                "if_speed": speed,
                "mac": f"02:00:00:00:{index >> 8 & 255:02x}:{index & 255:02x}",
                "in_rate": rate,
                "out_rate": rate * 3 // 4,
            }
        )
    return ports


