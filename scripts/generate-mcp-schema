#!/usr/bin/env python3
"""Export the map model for the PHP MCP boundary; fail CI when it drifts."""
from __future__ import annotations

import argparse
import json
from pathlib import Path
from typing import Any

from libremapper.config import MapConfig


def map_schema() -> dict[str, Any]:
    schema = MapConfig.model_json_schema()
    for key in ("key", "example"):
        schema["properties"].pop(key, None)
    schema.pop("required", None)

    def close_objects(value: Any) -> None:
        if isinstance(value, dict):
            if "properties" in value:
                value["additionalProperties"] = False
            for child in value.values():
                close_objects(child)
        elif isinstance(value, list):
            for child in value:
                close_objects(child)

    close_objects(schema)
    return schema


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    path = Path(__file__).resolve().parents[1] / "plugin/resources/mcp-map-schema.json"
    expected = json.dumps(map_schema(), indent=2) + "\n"
    if args.check:
        if path.read_text() != expected:
            raise SystemExit("MCP map schema is stale; run scripts/generate-mcp-schema")
    else:
        path.write_text(expected)
