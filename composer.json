{
    "name": "echotechnic/libremapper",
    "description": "Native LibreNMS UI client for the Libremapper sidecar",
    "type": "package",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.2",
        "librenms/plugin-interfaces": "^1.0",
        "mcp/sdk": "0.9.0",
        "symfony/psr-http-message-bridge": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "Libremapper\\Plugin\\": "plugin/src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Libremapper\\Plugin\\LibremapperServiceProvider"
            ]
        }
    }
}
